# PostgreSQL Serving Database
POSTGRES_DB=telecom_analytics
POSTGRES_USER=telecom
POSTGRES_PASSWORD=telecom
POSTGRES_PORT=5434

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Simulator Settings
SIMULATOR_INTERVAL_SEC=5
SIMULATOR_BATCH_LIMIT=2000
SIMULATOR_ANOMALY_RATE=0.05
SIMULATOR_BAD_DATA_RATE=0.01

# Flink Anomaly Detection Window (minutes)
OUTAGE_WINDOW_MINUTES=2

# Weather Enrichment Cache
WEATHER_CACHE_TTL_SEC=900
WEATHER_GRID_PRECISION=1

# Iceberg Sink Flush Policy
ICEBERG_BATCH_SIZE=5000
ICEBERG_FLUSH_INTERVAL_SEC=30

# Batch Analytics Refresh Interval (seconds)
ANALYTICS_REFRESH_INTERVAL_SEC=300
